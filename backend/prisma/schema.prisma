generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  DRIVER
  ADMIN
}

enum ProviderStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PriceMode {
  FIXED
  HOURLY
  QUOTE
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  clerkUserId   String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobPosts                  JobPost[]
  jobApplications           JobApplication[]
  serviceBookingsAsCustomer ServiceBooking[] @relation("ServiceCustomer")
  serviceBookingsAsProvider ServiceBooking[] @relation("ServiceProvider")
  rideRequestsAsCustomer    RideRequest[]    @relation("RideCustomer")
  driverProfile             Driver?
  providerProfile           Provider?
}

model Provider {
  id             String         @id @default(cuid())
  userId         String         @unique
  displayName    String
  nationalIdHash String         @unique
  idDocumentUrl  String?
  status         ProviderStatus @default(PENDING)
  lat            Float?
  lng            Float?
  location       Unsupported("geography(Point,4326)")?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  listings ServiceListing[]
}

model Driver {
  id            String   @id @default(cuid())
  userId        String   @unique
  vehicleMake   String
  vehicleModel  String
  vehiclePlate  String
  currentLat    Float?
  currentLng    Float?
  currentH3Cell String?
  ratingAvg     Float?
  ratingCount   Int?
  location      Unsupported("geography(Point,4326)")?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  rideRequests RideRequest[] @relation("RideDriver")

  @@index([currentH3Cell])
}

model ServiceCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  listings ServiceListing[]
}

model ServiceListing {
  id          String    @id @default(cuid())
  providerId  String
  categoryId  String
  title       String
  description String    @db.Text
  priceMode   PriceMode @default(FIXED)
  priceCents  Int?
  currency    String    @default("USD")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  provider Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  bookings ServiceBooking[]

  @@index([providerId])
  @@index([categoryId])
}

model ServiceBooking {
  id          String        @id @default(cuid())
  customerId  String
  providerId  String
  listingId   String
  status      BookingStatus @default(PENDING)
  priceCents  Int?
  currency    String        @default("USD")
  scheduledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer User           @relation("ServiceCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  provider User           @relation("ServiceProvider", fields: [providerId], references: [id])
  listing  ServiceListing @relation(fields: [listingId], references: [id])

  @@index([customerId])
  @@index([providerId])
  @@index([listingId])
}

model JobPost {
  id           String   @id @default(cuid())
  authorId     String
  title        String
  description  String   @db.Text
  company      String?
  jobType      String?
  category     String?
  salaryAmount Int?
  salaryFrom   Boolean?
  salaryEst    Boolean?
  rating       Float?
  reviews      Int?
  lat          Float?
  lng          Float?
  location     Unsupported("geography(Point,4326)")?
  search       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((((COALESCE(title, ''::text) || ' '::text) || COALESCE(company, ''::text)) || ' '::text) || description))"))
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([authorId])
  @@index([search], type: Gin)
  @@index([createdAt, id])
  @@index([salaryAmount, id])
  @@index([category])
}

model JobApplication {
  id          String            @id @default(cuid())
  postId      String
  applicantId String
  status      ApplicationStatus @default(SUBMITTED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  post      JobPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  applicant User    @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([postId, applicantId])
  @@index([postId])
  @@index([applicantId])
  @@index([applicantId, createdAt, id])
}

model RideRequest {
  id           String     @id @default(cuid())
  customerId   String
  driverId     String?
  pickupLat    Float
  pickupLng    Float
  dropoffLat   Float
  dropoffLng   Float
  pickupH3Cell String?
  fareCents    Int?
  status       RideStatus @default(REQUESTED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer User    @relation("RideCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  driver   Driver? @relation("RideDriver", fields: [driverId], references: [id])

  @@index([pickupH3Cell])
  @@index([customerId])
  @@index([driverId])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
