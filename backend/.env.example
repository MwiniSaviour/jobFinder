# Neon Postgres connection string (dev branch)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# HTTP server
PORT=4002

# Comma-separated CORS origins (web dev + Capacitor)
JF_CORS_ORIGINS=http://localhost:3000,capacitor://localhost,https://localhost

# Clerk auth (Backend API + custom JWT template issuer)
CLERK_ISSUER_URL=https://your-app.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_xxx

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Test-only override: local JWKS document (prevents network calls in vitest)
CLERK_JWKS_JSON=
